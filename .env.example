# ─────────────────────────────────────────────────────────────
#  Multi-Agent Text-to-SQL  –  Environment Configuration
# ─────────────────────────────────────────────────────────────

# ── LLM Provider & Failover ──────────────────────────────────
# Choose "gemini" (default with Groq fallback) or "groq"
LLM_PROVIDER=gemini

# ── Google Gemini (Multi-Key Workload Distribution & Failover) ──
# Comma-separated list of keys for round-robin rotation & auto-failover
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3
GEMINI_API_KEY=your_primary_gemini_key
GEMINI_MODEL=gemini-2.5-flash

# ── Groq (Ultra-fast Fallback & Provider) ──────────────────────
# Free API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenAI / Anthropic (Optional) ────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Database ─────────────────────────────────────────────────
# Path to the local SQLite file (relative to backend/)
DATABASE_PATH=analytics.db

# ── Agent Tuning ─────────────────────────────────────────────
MAX_RETRY_COUNT=3
SQL_ROW_LIMIT=1000

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000


